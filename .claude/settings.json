{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python C:\\repos\\skills\\scripts\\sync_agent_files.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "fabric-collection": {
      "source": {
        "source": "github",
        "repo": "microsoft/skills-for-fabric",
        "ref": "v0.3.14"
      }
    }
  },
  "enabledPlugins": {
    "fabric-skills@fabric-collection": true,
    "powerbi-authoring@fabric-collection": true
  }
}
