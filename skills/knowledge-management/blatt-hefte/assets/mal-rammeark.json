{
 "spesifikasjon_versjon": "1",
 "beskrivelse": "Maskinlesbar spesifikasjon av rammearket. mal.py bygger assets/mal-rammeark.xlsx fra denne filen, og bygg_rammeark.py (fase 4) fyller den samme layouten med data fra et kontraktdokument. Alle adresser i xlsx-filen er utledet av denne filen alene.",
 "layoutregler": {
  "tittelrad": 2,
  "enhetsrad": 3,
  "etikettkolonne": "B",
  "verdikolonne": "C",
  "tomme_rader_etter_blokk": 1,
  "plassholdere": {
   "{rad}": "radnummeret for den aktuelle raden i en tabellblokk",
   "{start}": "første datarad i blokken",
   "{slutt}": "siste datarad i blokken",
   "{nest_siste}": "nest siste datarad i blokken",
   "{sum}": "radnummeret for sumraden i blokken",
   "@navn": "erstattes med absolutt adresse til den navngitte cellen, f.eks. @hovedtall_rnb -> 'Hovedtall'!$C$21"
  },
  "radantall": "mal_radantall gjelder bare malen. bygg_mal(spec, output, radantall={blokknavn: n}) bygger samme layout med faktisk radantall, og _meta-arket viser hvor hver navngitt celle havnet."
 },
