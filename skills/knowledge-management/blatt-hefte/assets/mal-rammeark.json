       "formel": "=IF(@hovedtall_rnb=\"\",\"ikke oppgitt\",D{hovedposter_start}+@hovedtall_rnb)",
       "format": "belop"
      },
      {
       "navn": "hovedposter_rnb_forslag",
       "etikett": "Forslag inkl. RNB",
       "formel": "=IF(@hovedtall_rnb=\"\",\"ikke oppgitt\",D{hovedposter_slutt}+@hovedtall_rnb)",
       "format": "belop"
      },
      {
       "navn": "hovedposter_rnb_nominell",
       "etikett": "Nominell endring inkl. RNB",
       "formel": "=IF(@hovedtall_rnb=\"\",\"ikke oppgitt\",(D{hovedposter_slutt}-D{hovedposter_start})/(D{hovedposter_start}+@hovedtall_rnb))",
       "format": "prosent"
      },
      {
       "navn": "hovedposter_rnb_realvekst",
       "etikett": "Realvekst (metode b) inkl. RNB",
       "formel": "=IF(@hovedtall_rnb=\"\",\"ikke oppgitt\",(D{hovedposter_slutt}-D{hovedposter_start}-@hovedtall_prisjustering)/(D{hovedposter_start}+@hovedtall_rnb))",
       "format": "prosent"
      }
     ]
    }
