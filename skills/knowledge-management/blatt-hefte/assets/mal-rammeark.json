   "navn": "Hovedtall",
   "tittel": "Hovedtall for UiT, kap. 260 post 50",
   "vis_enhet": true,
   "kolonnebredder": {
    "A": 2.5,
    "B": 54,
    "C": 18,
    "D": 44
   },
   "startrad": 5,
   "blokker": [
    {
     "navn": "hovedtall_hoveddel",
     "type": "rader",
     "overskrift": [
      "Hovedtall",
      "Verdi"
     ],
     "rader": [
      {
       "navn": "hovedtall_utgangspunkt",
       "etikett": "Utgangspunkt (heftets første kolonne)",
       "etikett_navn": "hovedtall_etikett_utgangspunkt",
       "etikett_felt": "hovedtabell.kolonner[0]",
       "felt": "uit.utgangspunkt",
       "format": "belop"
      },
      {
       "navn": "hovedtall_forslag",
       "etikett": "Forslag (heftets siste kolonne)",
       "etikett_navn": "hovedtall_etikett_forslag",
       "etikett_felt": "hovedtabell.kolonner[-1]",
       "felt": "uit.forslag",
       "format": "belop"
      },
      {
       "navn": "hovedtall_endring",
       "etikett": "Endring i kroner",
       "formel": "=@hovedtall_forslag-@hovedtall_utgangspunkt",
       "format": "belop"
      },
      {
       "navn": "hovedtall_nominell",
       "etikett": "Nominell endring",
       "formel": "=@hovedtall_endring/@hovedtall_utgangspunkt",
       "format": "prosent"
      },
      {
       "navn": "hovedtall_prissats",
       "etikett": "Prisjusteringssats i heftet",
       "felt": "prisjustering.sats_prosent_desimal",
       "format": "prosent"
      },
      {
       "navn": "hovedtall_realvekst_b",
       "etikett": "Realvekst (metode b, uten RNB)",
       "formel": "=(@hovedtall_endring-@hovedtall_prisjustering)/@hovedtall_utgangspunkt",
       "format": "prosent"
      },
      {
       "navn": "hovedtall_realvekst_b_rnb",
       "etikett": "Realvekst (metode b, med RNB <år−1> i utgangspunktet)",
       "formel": "=IF(@hovedtall_rnb=\"\",\"ikke oppgitt\",(@hovedtall_endring-@hovedtall_prisjustering)/(@hovedtall_utgangspunkt+@hovedtall_rnb))",
       "format": "prosent"
      }
     ]
    },
    {
     "navn": "hovedtall_kontroll",
     "type": "rader",
     "overskrift": [
      "Kontroll",
      "Verdi"
     ],
     "rader": [
      {
       "navn": "hovedtall_prisjustering",
       "etikett": "Prisjustering i kroner fra heftet",
       "felt": "prisjustering.uit_kolonne",
       "format": "belop"
      },
      {
       "navn": "hovedtall_sats_x_utgangspunkt",
       "etikett": "Sats x utgangspunkt",
       "formel": "=ROUND(@hovedtall_prissats*@hovedtall_utgangspunkt,0)",
       "format": "belop"
      },
      {
       "navn": "hovedtall_prisavvik",
       "etikett": "Avvik (heftet minus sats x utgangspunkt)",
       "formel": "=@hovedtall_prisjustering-@hovedtall_sats_x_utgangspunkt",
       "format": "belop"
      },
      {
       "navn": "hovedtall_ren_sats",
       "etikett": "Ren sats (avvik innenfor toleranse)",
       "felt": "prisjustering.ren_sats_tekst",
       "format": "tekst"
      },
      {
       "navn": "hovedtall_realvekst_a",
       "etikett": "Realvekst (metode a, uten RNB)",
       "formel": "=@hovedtall_nominell-@hovedtall_prissats",
       "format": "prosent"
      },
      {
       "navn": "hovedtall_realvekst_a_rnb",
       "etikett": "Realvekst (metode a, med RNB <år−1> i utgangspunktet)",
       "formel": "=IF(@hovedtall_rnb=\"\",\"ikke oppgitt\",@hovedtall_endring/(@hovedtall_utgangspunkt+@hovedtall_rnb)-@hovedtall_prissats)",
       "format": "prosent"
      },
      {
       "navn": "hovedtall_realvekst_b_rnb_varig",
       "etikett": "Realvekst (metode b) om RNB-endringen er varig og ikke inngår i prisjusteringskolonnen",
       "formel": "=IF(@hovedtall_rnb=\"\",\"ikke oppgitt\",(@hovedtall_forslag-(@hovedtall_utgangspunkt+@hovedtall_rnb)-@hovedtall_prisjustering)/(@hovedtall_utgangspunkt+@hovedtall_rnb))",
       "format": "prosent"
      },
      {
       "navn": "hovedtall_rnb_regime",
       "etikett": "RNB-regime (utledet av skriptet)",
       "felt": "rnb.regime",
       "format": "tekst"
      },
      {
       "navn": "hovedtall_rnb",
       "etikett": "RNB-endring <år−1> for UiT, kap. 260 post 50, fra budsjettbasen (KDs supplerende tildelingsbrev); tom = ikke justert",
       "inndata": true,
       "format": "belop"
      }
     ]
    }
   ]
